# Exemplo de variáveis: definir no terminal; carregamento automático de .env não implementado.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=casa_atelie
POSTGRES_USER=casa_atelie
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Apenas para PostgreSQL local sem TLS; remoto usa verify-full e certificado confiável.
POSTGRES_SSLMODE=disable
